# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase database, storage, and email authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_URL=copy_the_full_postgres_connection_string
# Keep false anywhere reachable by other people. Local-only development may
# temporarily set this to true when email delivery is unavailable.
AUTH_AUTO_CONFIRM=false

# Optional dedicated secret used to one-way fingerprint rate-limit subjects.
# If omitted, the server-only Supabase service-role key is used as the HMAC key.
RATE_LIMIT_SALT=replace_with_a_long_random_value

# Protected Super Admin account
SUPER_ADMIN_EMAIL=chaplin@chaplin.in
SUPER_ADMIN_PASSWORD=replace_with_a_strong_password

# Writing, planning, conversions, character rooms, and OpenAI image generation
OPENAI_API_KEY=your_openai_api_key
OPENAI_WRITING_MODEL=gpt-5.6-terra

# Voice, dialogue, sound effects, music, and Concierge
# Preferred app-specific override during account rotation:
# CHAPLIN_ELEVENLABS_API_KEY=your_chaplin_elevenlabs_api_key
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key
CHAPLIN_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id
CHAPLIN_ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# BytePlus image/video generation
SEEDREAM_API_KEY=your_seedream_api_key
SEEDANCE_API_KEY=your_seedance_api_key

# Optional routed image providers
# OpenRouter remains inactive until Super Admin selects it as the image provider.
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional pricing overrides used by Admin logs
USD_TO_INR_RATE=86.23
CHAPLIN_TOKENS_PER_USD=10000
OPENAI_TERRA_INPUT_USD_PER_MILLION_TOKENS=2.5
OPENAI_TERRA_OUTPUT_USD_PER_MILLION_TOKENS=15
ELEVEN_TTS_USD_PER_1K_CHARACTERS=0.30
ELEVEN_SFX_USD_PER_MINUTE=0.30
ELEVEN_MUSIC_USD_PER_MINUTE=0.50
SEEDREAM_USD_PER_IMAGE=0.04
SEEDANCE_USD_PER_SECOND=0.10
OPENAI_IMAGE_USD_PER_IMAGE=0.08
