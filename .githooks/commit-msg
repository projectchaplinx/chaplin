#!/bin/sh
set -eu

# Every commit title carries the version the pre-commit hook just computed,
# so deploy lists and history stay identifiable. Hand-written prefixes were
# skipped or wrong; the stamp comes from version.json and cannot drift.
MSG_FILE="$1"

case "$(head -n 1 "$MSG_FILE")" in
  v[0-9]*.[0-9]*.[0-9]*:*) exit 0 ;;
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

VERSION=$(node -p "require('./version.json').version")
{ printf 'v%s: ' "$VERSION"; cat "$MSG_FILE"; } > "$MSG_FILE.tmp"
mv "$MSG_FILE.tmp" "$MSG_FILE"
